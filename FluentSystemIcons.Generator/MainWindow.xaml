<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluentSystemIcons.Generator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentSystemIcons.Generator"
    xmlns:controls="using:FluentSystemIcons.Generator.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Fluent System Icons - SDK Generator">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <!-- RECURSOS LOCALES DECLARADOS CORRECTAMENTE DENTRO DEL GRID RAÍZ -->
            <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#FF14161A"/>
            <SolidColorBrush x:Key="TerminalForegroundBrush" Color="#FF4AF626"/>
            <SolidColorBrush x:Key="TerminalBorderBrush" Color="#FF2D3139"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <!-- Fila 0: Barra de Título Customizada (Estilo Windows 11) -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: Espacio de Trabajo Principal -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA DE TÍTULO PERSONALIZADA -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="48"
              Background="Transparent"
              Margin="12,0"
              Visibility="Collapsed"
              Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightPaddingColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Cabecera e Iconografía de la App en Barra de Título -->
            <StackPanel x:Name="AppTitlePanel"
                        Grid.Column="0" 
                        Orientation="Horizontal" 
                        Spacing="12" 
                        VerticalAlignment="Center">
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" 
                          Glyph="&#xE909;" 
                          Foreground="{ThemeResource SystemAccentColor}" 
                          FontSize="16"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Uid="AppTitleBar_Title"
                               Text="Fluent System Icons" 
                               Style="{StaticResource CaptionTextBlockStyle}" 
                               FontWeight="SemiBold" 
                               VerticalAlignment="Center"/>
                    <TextBlock x:Uid="AppTitleBar_Subtitle"
                               Text="SDK Generator" 
                               FontSize="11" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Botón de Cambio de Tema Rápido -->
            <Button x:Name="ThemeButton"
                    Grid.Column="2" 
                    VerticalAlignment="Center" 
                    Click="ThemeButton_Click"
                    Width="36" 
                    Height="36" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    Padding="0" 
                    Margin="12,0,0,0">
                <ToolTipService.ToolTip>
                    <ToolTip Content="{x:Bind ThemeButtonToolTip, Mode=OneWay}"/>
                </ToolTipService.ToolTip>
                <FontIcon x:Name="ThemeIcon" 
                          FontFamily="{StaticResource SymbolThemeFontFamily}" 
                          Glyph="&#xE706;"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" 
                          FontSize="14" />
            </Button>

            <!-- Botón de Ajustes (Hospeda el control de usuario en un Flyout) -->
            <Button x:Name="SettingsButton" 
                    Grid.Column="3" 
                    VerticalAlignment="Center"
                    Width="36" 
                    Height="36" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    Padding="0" 
                    Margin="8,0,0,0">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="False">
                        <controls:SettingsControl x:Name="SettingsFlyoutContent"/>
                    </Flyout>
                </Button.Flyout>
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" 
                          Glyph="&#xE713;"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" 
                          FontSize="14" />
            </Button>
        </Grid>

        <!-- ESPACIO DE TRABAJO PRINCIPAL (Contenedor original) -->
        <Grid Grid.Row="1" Padding="28,12,28,28" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO: AJUSTES Y CONFIGURACIÓN -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <StackPanel Spacing="16">

                    <!-- TARJETA 1: DIRECTORIOS DEL SDK -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xED25;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                                <TextBlock x:Uid="Card_Paths_Title" Text="Rutas del Proyecto" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="15"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Card_Paths_WinUIPathLabel" Text="Directorio de FluentSystemIcons.WinUI" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Medium"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WinUIPathTextBox" x:Uid="WinUIPathTextBox" Grid.Column="0" PlaceholderText="Seleccione la carpeta del proyecto WinUI 3..." VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Click="BrowseWinUIPath_Click" ToolTipService.ToolTip="Examinar Carpeta" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8B7;" FontSize="14"/>
                                    </Button>
                                </Grid>
                                <TextBlock x:Uid="Card_Paths_WinUIPathDesc" Text="Estructura donde se generarán las fuentes (.ttf) y constantes (.cs)." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TARJETA 2: PARÁMETROS DE COMPILACIÓN -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE713;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                                <TextBlock x:Uid="Card_BuildParams_Title" Text="Parámetros de Compilación" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="15"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Card_BuildParams_NamespaceLabel" Text="Namespace C# de Salida" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Medium"/>
                                <TextBox x:Name="NamespaceTextBox" x:Uid="NamespaceTextBox" Text="FluentSystemIcons" PlaceholderText="Escriba el espacio de nombres..."/>
                            </StackPanel>

                            <StackPanel Spacing="8" Margin="0,6,0,0">
                                <TextBlock x:Uid="Card_BuildParams_StylesLabel" Text="Estilos Iconográficos a Sincronizar" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Medium"/>
                                <Grid ColumnSpacing="16" RowSpacing="10" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox x:Name="RegularCheckBox" x:Uid="CheckBox_Regular" Content="Regular (Esquema)" IsChecked="True" Grid.Column="0" Grid.Row="0"/>
                                    <CheckBox x:Name="FilledCheckBox" x:Uid="CheckBox_Filled" Content="Filled (Relleno)" IsChecked="True" Grid.Column="1" Grid.Row="0"/>
                                    <CheckBox x:Name="LightCheckBox" x:Uid="CheckBox_Light" Content="Light (Fino)" IsChecked="True" Grid.Column="0" Grid.Row="1"/>
                                    <CheckBox x:Name="ResizableCheckBox" x:Uid="CheckBox_Resizable" Content="Resizable (Dinámico)" IsChecked="True" Grid.Column="1" Grid.Row="1"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TARJETA 3: EMPAQUETADO NUGET -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7B8;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                                <TextBlock x:Uid="Card_NuGet_Title" Text="Empaquetado NuGet Autónomo" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="15"/>
                            </StackPanel>

                            <CheckBox x:Name="PackNuGetCheckBox" 
                                      x:Uid="CheckBox_PackNuGet"
                                      Content="Generar paquete NuGet (.nupkg) al finalizar" 
                                      IsChecked="True" 
                                      Checked="PackNuGetCheckBox_StateChanged" 
                                      Unchecked="PackNuGetCheckBox_StateChanged"/>

                            <StackPanel Spacing="12" x:Name="NuGetVersionPanel">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Uid="Card_NuGet_VersionLabel" Text="Versión del paquete NuGet" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Medium"/>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NuGetVersionTextBox" Grid.Column="0" Text="1.0.0" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="UseCatalogVersionCheckBox" 
                                                  x:Uid="CheckBox_UseCatalogVersion"
                                                  Grid.Column="1" 
                                                  Content="Sincronizar con GitHub" 
                                                  IsChecked="True" 
                                                  Checked="UseCatalogVersionCheckBox_StateChanged" 
                                                  Unchecked="UseCatalogVersionCheckBox_StateChanged" 
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock x:Uid="Card_NuGet_FolderLabel" Text="Carpeta de Destino de Paquetes NuGet (.nupkg)" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Medium"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NuGetOutputPathTextBox" x:Uid="NuGetOutputPathTextBox" Grid.Column="0" PlaceholderText="Seleccione la carpeta de salida del paquete..." VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Click="BrowseNuGetOutputPath_Click" ToolTipService.ToolTip="Examinar Carpeta" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8B7;" FontSize="14"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TARJETA 4: CONTROL DE VERSIONES -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEC3F;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                                <TextBlock x:Uid="Card_VersionControl_Title" Text="Control de Versiones del Catálogo" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="15"/>
                            </StackPanel>

                            <Grid ColumnSpacing="12" RowSpacing="10" Margin="0,4,0,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Fila 1: Versión Local -->
                                <FontIcon Grid.Row="0" Grid.Column="0" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7F4;" Foreground="{ThemeResource SystemAccentColor}" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock x:Uid="Label_LocalVersion" Grid.Row="0" Grid.Column="1" Text="Versión local instalada" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                                <Border Grid.Row="0" Grid.Column="2" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" FontSize="11">
                                        <Run x:Name="LocalVersionRun" Text="Comprobando..."/>
                                    </TextBlock>
                                </Border>

                                <!-- Fila 2: Versión en GitHub -->
                                <FontIcon Grid.Row="1" Grid.Column="0" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE128;" Foreground="{ThemeResource SystemAccentColor}" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock x:Uid="Label_GitHubVersion" Grid.Row="1" Grid.Column="1" Text="Última versión en GitHub" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
                                <Border Grid.Row="1" Grid.Column="2" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" FontSize="11">
                                        <Run x:Name="GitHubVersionRun" Text="Comprobando..."/>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- TARJETA 5: AUTOMATIZACIÓN DE MICROSOFT GITHUB -->
                    <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE73E;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                                <TextBlock x:Uid="Card_DirectSync_Title" Text="Sincronización Directa"/>
                            </StackPanel>
                            <TextBlock x:Uid="Card_DirectSync_Description" Text="Esta función descarga las fuentes .ttf y estilos .css actualizados directamente desde el repositorio original de Microsoft en GitHub de manera totalmente automatizada." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            <CheckBox x:Name="AutoDownloadCheckBox" x:Uid="CheckBox_AutoDownload" Content="Sincronizar recursos desde GitHub" IsChecked="True" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- PANEL DERECHO: CONSOLA DE DIAGNÓSTICO Y EJECUCIÓN -->
            <Grid Grid.Column="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ALERTA DE ACTUALIZACIÓN (INFOBAR INTEGRADO) -->
                <InfoBar x:Name="VersionUpdateInfoBar"
                         Grid.Row="0"
                         Title="Información del Catálogo"
                         Message="Se está verificando si existen nuevos iconos..."
                         Severity="Informational"
                         IsOpen="True"
                         Margin="0,0,0,4">
                    <InfoBar.ActionButton>
                        <Button x:Name="VerifyVersionButton" x:Uid="VerifyVersionButton" Content="Verificar versión" Click="VerifyVersionButton_Click" Style="{StaticResource AccentButtonStyle}"/>
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- CONSOLA DE DIAGNÓSTICO INTEGRADA REDISEÑADA -->
                <Border Grid.Row="1" Background="{StaticResource TerminalBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource TerminalBorderBrush}" BorderThickness="1">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Cabecera de la Consola -->
                        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource TerminalBorderBrush}" CornerRadius="8,8,0,0" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE756;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                    <TextBlock x:Uid="Console_Title" Text="Consola de Diagnóstico" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Click="CopyLogButton_Click" Style="{ThemeResource AccentButtonStyle}" Background="Transparent" BorderThickness="0" Padding="8,4" ToolTipService.ToolTip="Copiar Consola">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock x:Uid="Console_CopyButton_Text" Text="Copiar" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ClearLogButton_Click" Background="Transparent" BorderThickness="0" Padding="8,4" ToolTipService.ToolTip="Limpiar Consola">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE894;" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock x:Uid="Console_ClearButton_Text" Text="Limpiar" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Panel de salida de la Consola -->
                        <ScrollViewer x:Name="LogScrollViewer" Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogTextBlock" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource TerminalForegroundBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- PROGRESO Y ESTADO DEL PROCESAMIENTO -->
                <Grid Grid.Row="2" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ProgressStatusTextBlock" Grid.Row="0" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" Visibility="Collapsed"/>
                    <ProgressBar x:Name="GenerationProgressBar" Grid.Row="1" Value="0" Maximum="100" IsIndeterminate="False" Height="6" CornerRadius="3" Visibility="Collapsed"/>
                </Grid>

                <!-- ACCIÓN PRINCIPAL / GENERAR RECURSOS -->
                <Button x:Name="GenerateButton" 
                        Grid.Row="3" 
                        Content="Generar Recursos" 
                        Style="{StaticResource AccentButtonStyle}" 
                        HorizontalAlignment="Stretch" 
                        Height="48" 
                        CornerRadius="6" 
                        FontSize="15" 
                        FontWeight="SemiBold" 
                        Click="GenerateButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>