<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FluentSystemIcons.Generator.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentSystemIcons.Generator">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Recursos de controles predeterminados del SDK -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- Integración de recursos de la biblioteca de iconos (Permite usar FontIcon en la UI del generador) -->
                <ResourceDictionary Source="ms-appx:///FluentSystemIcons.WinUI/Resources/FluentIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Pinceles de colores sólidos idénticos a los de la galería -->
            <SolidColorBrush x:Key="SolidBackgroundBrushLight" Color="#FFF3F3F3"/>
            <SolidColorBrush x:Key="SolidBackgroundBrushDark" Color="#FF03070B"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>