<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentSystemIcons.Gallery.UserControls.SidePanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FluentSystemIcons.Gallery.UserControls"
    mc:Ignorable="d">

    <Grid>
        <Grid x:Name="DetailsGrid" Padding="24" RowSpacing="16" Opacity="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. ICONO GRANDE EN SU PROPIO PANEL -->
            <Border Grid.Row="0" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="8" HorizontalAlignment="Stretch">
                <FontIcon x:Name="IconDisplayTextBlock" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="120"/>
            </Border>

            <!-- 2. SWITCH DE CÓDIGO -->
            <local:CodeViewSwitcher x:Name="CodeSwitcher" Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,8" SelectionChanged="CodeSwitcher_SelectionChanged"/>

            <!-- 3. DETALLES DEBAJO DEL SWITCH -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,-12,0,0">
                <StackPanel Spacing="24">

                    <!-- SECCIÓN: VISTA PREVIA DE CONTEXTO UI -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="SidePanel_ContextPreview_Header" Text="Vista Previa de Contexto UI" Style="{ThemeResource CaptionTextBlockStyle}"/>
                        <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="16">
                                <!-- Escenario 1: Botón con Icono y Texto -->
                                <Button HorizontalAlignment="Stretch" Padding="16,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="PreviewButtonIcon" FontSize="16"/>
                                        <TextBlock x:Uid="SidePanel_ContextPreview_PrimaryAction" Text="Acción Primaria" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Escenario 2: Botón de barra de comandos (circular) -->
                                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource AccentButtonStyle}" CornerRadius="20" Width="40" Height="40" Padding="0">
                                        <FontIcon x:Name="PreviewCircularIcon" FontSize="16"/>
                                    </Button>
                                    <Button CornerRadius="20" Width="40" Height="40" Padding="0">
                                        <FontIcon x:Name="PreviewCircularIconSecondary" FontSize="16"/>
                                    </Button>
                                </StackPanel>

                                <!-- Escenario 3: Elemento de Navegación lateral -->
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon x:Name="PreviewNavIcon" Grid.Column="0" FontSize="18" VerticalAlignment="Center"/>
                                        <TextBlock x:Uid="SidePanel_ContextPreview_MenuItem" Grid.Column="1" Text="Elemento de Menú" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Medium"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECCIÓN: Nombre y Favorito -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="SidePanel_NameHeader" Style="{ThemeResource CaptionTextBlockStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IconNameValueTextBlock" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>

                            <!-- Botón de Alternancia de Favoritos (Estrella del propio NuGet) -->
                            <Button x:Name="FavoriteButton" 
                                    Grid.Column="1" 
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    VerticalAlignment="Center" 
                                    Margin="0,0,8,0"
                                    Click="FavoriteButton_Click">
                                <ToolTipService.ToolTip>
                                    <ToolTip x:Name="FavoriteButtonToolTip" Content="Agregar a Favoritos"/>
                                </ToolTipService.ToolTip>
                                <FontIcon x:Name="FavoriteButtonIcon" FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xF70F;" FontSize="18"/>
                            </Button>

                            <Button x:Name="CopyNameButton" x:Uid="CopyNameButton" Grid.Column="2" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CopyNameButton_Click" PointerExited="CopyButton_PointerExited">
                                <Grid Width="20" Height="20">
                                    <FontIcon Tag="Copy" FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xF32B;" FontSize="18"/>
                                    <FontIcon Tag="Check" FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xE305;" FontSize="18" Opacity="0"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- SECCIÓN: Texto/Código Glyph -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="GlyphCodeTitleTextBlock" Style="{ThemeResource CaptionTextBlockStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GlyphCodeValueTextBlock" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontFamily="Consolas" IsTextSelectionEnabled="True"/>
                            <TextBlock x:Name="CSharpGlyphCodeValueTextBlock" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" FontFamily="Consolas" IsTextSelectionEnabled="True"/>
                            <Button x:Name="CopyGlyphButton" x:Uid="SidePanel_CopyGlyphText" Grid.Column="1" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CopyGlyphButton_Click" PointerExited="CopyButton_PointerExited">
                                <Grid Width="20" Height="20">
                                    <FontIcon Tag="Copy" FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xF32B;" FontSize="18"/>
                                    <FontIcon Tag="Check" FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xE305;" FontSize="18" Opacity="0"/>
                                </Grid>
                            </Button>
                            <Button x:Name="CopyCSharpGlyphButton" x:Uid="SidePanel_CopyGlyphCode" Grid.Column="1" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CopyCSharpGlyphButton_Click" Visibility="Collapsed" PointerExited="CopyButton_PointerExited">
                                <Grid Width="20" Height="20">
                                    <FontIcon Tag="Copy" FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xF32B;" FontSize="18"/>
                                    <FontIcon Tag="Check" FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xE305;" FontSize="18" Opacity="0"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- SECCIÓN: Font Icon -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="FontIconTitleTextBlock" Style="{ThemeResource CaptionTextBlockStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FontIconValueTextBlock" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontFamily="Consolas" IsTextSelectionEnabled="True"/>
                            <TextBlock x:Name="CSharpFontIconValueTextBlock" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" FontFamily="Consolas" IsTextSelectionEnabled="True"/>
                            <Button x:Name="CopyFontIconButton" 
                                    x:Uid="SidePanel_CopyFontIconXaml" Grid.Column="1" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CopyFontIconButton_Click" PointerExited="CopyButton_PointerExited">
                                <Grid Width="20" Height="20">
                                    <FontIcon Tag="Copy" FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xF32B;" FontSize="18"/>
                                    <FontIcon Tag="Check" FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xE305;" FontSize="18" Opacity="0"/>
                                </Grid>
                            </Button>
                            <Button x:Name="CopyCSharpFontIconButton" 
                                    x:Uid="SidePanel_CopyFontIconCSharp" Grid.Column="1" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CopyCSharpFontIconButton_Click" Visibility="Collapsed" PointerExited="CopyButton_PointerExited">
                                <Grid Width="20" Height="20">
                                    <FontIcon Tag="Copy" FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xF32B;" FontSize="18"/>
                                    <FontIcon Tag="Check" FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xE305;" FontSize="18" Opacity="0"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- SECCIÓN: Código SVG (Copia Vectorial pura extraída por Win2D) -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="SidePanel_Svg_Header" x:Name="SvgIconTitleTextBlock" Text="Código SVG Vectorial (Win2D)" Style="{ThemeResource CaptionTextBlockStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SvgIconValueTextBlock" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontFamily="Consolas" IsTextSelectionEnabled="True"/>
                            <Button x:Name="CopySvgIconButton" 
                                    ToolTipService.ToolTip="Copiar como SVG"
                                    Grid.Column="1" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CopySvgIconButton_Click" PointerExited="CopyButton_PointerExited">
                                <Grid Width="20" Height="20">
                                    <FontIcon Tag="Copy" FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xF32B;" FontSize="18"/>
                                    <FontIcon Tag="Check" FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xE305;" FontSize="18" Opacity="0"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="InitialMessageTextBlock" x:Uid="SidePanel_InitialMessage" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
</UserControl>