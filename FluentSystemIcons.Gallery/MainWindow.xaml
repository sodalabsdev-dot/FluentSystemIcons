<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluentSystemIcons.Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentSystemIcons.Gallery"
    xmlns:models="using:FluentSystemIcons.Gallery.Models"
    xmlns:controls="using:FluentSystemIcons.Gallery.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:FluentSystemIcons.Gallery.Helpers"
    mc:Ignorable="d"
    Title="Fluent System Icons Gallery">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- BARRA DE TÍTULO -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="48"
              Background="Transparent"
              Margin="12,0"
              Visibility="Collapsed"
              Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <!-- Columna para el Botón de Tema (acceso rápido) -->
                <ColumnDefinition Width="Auto" />
                <!-- Columna para el Botón de Ajustes -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightPaddingColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="AppTitlePanel"
                        Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="/Assets/StoreLogo.svg" Width="24" Height="24" />
                <StackPanel>
                    <TextBlock Text="Fluent System Icons" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Text="Gallery" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Buscador Moderno estilo Windows 11 (Lupa de la Librería + Línea Separadora + Textbox Padeado) -->
            <Grid Grid.Column="2" Width="300" VerticalAlignment="Center" Height="36">
                <AutoSuggestBox x:Name="IconSearchBox"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                x:Uid="SearchBox"
                                TextChanged="IconSearchBox_TextChanged"
                                QuerySubmitted="IconSearchBox_QuerySubmitted"
                                SuggestionChosen="IconSearchBox_SuggestionChosen"
                                GotFocus="IconSearchBox_GotFocus"
                                UpdateTextOnSelect="False"
                                Height="36"
                                CornerRadius="18">
                    <AutoSuggestBox.Resources>
                        <!-- Sobrescribe las esquinas del TextBox del buscador -->
                        <CornerRadius x:Key="ControlCornerRadius">18</CornerRadius>
                        <CornerRadius x:Key="TextControlCornerRadius">18</CornerRadius>

                        <!-- Hace que las esquinas superiores del desplegable flotante sean planas (0) y las inferiores redondeadas (8) -->
                        <CornerRadius x:Key="OverlayCornerRadius">0,0,8,8</CornerRadius>

                        <!-- Estilo para el botón de borrar (Clear / DeleteButton) en el lado derecho -->
                        <Style TargetType="Button">
                            <Setter Property="Width" Value="30"/>
                            <Setter Property="Height" Value="30"/>
                            <Setter Property="MinWidth" Value="30"/>
                            <Setter Property="MinHeight" Value="30"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="CornerRadius" Value="15"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0,3,0"/>
                        </Style>
                    </AutoSuggestBox.Resources>

                    <AutoSuggestBox.TextBoxStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="CornerRadius" Value="18"/>
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Padding" Value="46,6,36,6"/>
                        </Style>
                    </AutoSuggestBox.TextBoxStyle>

                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="models:IconInfo">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontFamily="{x:Bind FontFamily}" Glyph="{x:Bind Glyph}" FontSize="18"/>
                                <TextBlock Text="{x:Bind DisplayName}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>

                <!-- 1. ICONO DE LUPA ESTÁTICO (Vinculado dinámicamente a la propiedad de su librería en C#) -->
                <FontIcon FontFamily="{StaticResource FluentIconsRegular}" 
                          Glyph="{x:Bind SearchIconGlyph}" 
                          FontSize="16" 
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Margin="14,0,0,0"
                          IsHitTestVisible="False"/>

                <!-- 2. LÍNEA VERTICAL SEPARADORA (Límite visual de zona muerta) -->
                <Border Width="1" 
                        Height="16" 
                        Background="{ThemeResource ControlStrokeColorDefaultBrush}" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center"
                        Margin="36,0,0,0"
                        IsHitTestVisible="False"/>
            </Grid>

            <!-- Botón de Tema Rápido -->
            <Button x:Name="ThemeButton"
                    Grid.Column="3" VerticalAlignment="Center" Click="ThemeButton_Click"
                    Width="36" Height="36" Background="Transparent" BorderThickness="0" Padding="0" Margin="24,0,0,0">
                <ToolTipService.ToolTip>
                    <ToolTip Content="{x:Bind ThemeButtonToolTip, Mode=OneWay}"/>
                </ToolTipService.ToolTip>
                <FontIcon x:Name="ThemeIcon" FontFamily="{StaticResource FluentIconsFilled}" Glyph="&#xE20A;"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Button>

            <!-- Botón de Ajustes -->
            <Button x:Name="SettingsButton" x:Uid="SettingsButton"
                    Grid.Column="4" VerticalAlignment="Center"
                    Width="36" Height="36" Background="Transparent" BorderThickness="0" Padding="0" Margin="12,0,0,0">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="False">
                        <controls:SettingsControl x:Name="SettingsFlyoutContent"/>
                    </Flyout>
                </Button.Flyout>
                <FontIcon FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xF6A8;"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Button>
        </Grid>

        <!-- ÁREA PRINCIPAL DIVIDIDA -->
        <Grid Grid.Row="1" x:Name="MainContentGrid">
            <Grid.Resources>
                <helpers:GridLengthAnimationHelper x:Key="ColumnAnimationHelper"/>
            </Grid.Resources>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition x:Name="SidePanelColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO: CONTENEDOR DE ICONOS -->
            <Grid x:Name="ContentContainer"
                  Grid.Column="0"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  Margin="12,0,12,12"
                  CornerRadius="8"
                  Visibility="Collapsed"
                  Opacity="0">

                <Grid.Resources>
                    <MenuFlyout x:Key="IconCardFlyout" Opening="IconCardFlyout_Opening">
                        <MenuFlyoutItem x:Uid="CopyGlyphMenuItem" Click="CopyGlyph_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xF32B;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="CopyFontIconMenuItem" Click="CopyFontIcon_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xF32B;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="CopySvgMenuItem" Text="Copiar Código SVG" Click="CopySvg_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xF32B;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="ExportSvgMenuItem" Text="Exportar como archivo SVG..." Click="ExportSvg_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xE105;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Tag="ToggleFavorite" Click="ToggleFavorite_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xF70F;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>

                    <DataTemplate x:Key="LargeIconTemplate" x:DataType="models:IconInfo">
                        <controls:IconCard Item="{x:Bind}" ContextFlyout="{StaticResource IconCardFlyout}" Width="190" Height="280" IconFontSize="64"/>
                    </DataTemplate>

                    <DataTemplate x:Key="MediumIconTemplate" x:DataType="models:IconInfo">
                        <Grid Width="110" Height="150" ContextFlyout="{StaticResource IconCardFlyout}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                            <Grid Padding="8" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <FontIcon Grid.Row="0" FontFamily="{x:Bind FontFamily, Mode=OneTime}" Glyph="{x:Bind Glyph, Mode=OneTime}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="1" Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate x:Key="SmallIconTemplate" x:DataType="models:IconInfo">
                        <Grid Width="80" Height="110" ContextFlyout="{StaticResource IconCardFlyout}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                            <FontIcon FontFamily="{x:Bind FontFamily, Mode=OneTime}" Glyph="{x:Bind Glyph, Mode=OneTime}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>

                    <Style x:Key="RoundedGridViewItemStyle" TargetType="GridViewItem">
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewItem">
                                    <Grid x:Name="Root" CornerRadius="8">
                                        <Border x:Name="SelectionIndicator"
                            Background="Transparent"
                            BorderBrush="{ThemeResource SystemAccentColor}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Opacity="0"/>

                                        <ContentPresenter x:Name="ContentPresenter"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Padding="{TemplateBinding Padding}">
                                            <ContentPresenter.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="ContentScaleTransform" CenterX="95" CenterY="140" ScaleX="1.0" ScaleY="1.0" />
                                                    <TranslateTransform x:Name="ContentTranslateTransform" Y="0" />
                                                </TransformGroup>
                                            </ContentPresenter.RenderTransform>
                                        </ContentPresenter>

                                        <VisualStateManager.VisualStateGroups>
                                            <!-- Este grupo maneja el hover en items NO seleccionados -->
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />

                                                <VisualState x:Name="PointerOver">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ContentScaleTransform"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1.03" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="ContentScaleTransform"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1.03" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="ContentTranslateTransform"
                                                     Storyboard.TargetProperty="Y"
                                                     To="-4" Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>

                                            <!-- ======================================================= -->

                                            <VisualStateGroup x:Name="SelectionStates">
                                                <VisualState x:Name="Unselected" />

                                                <!-- Cuando está seleccionado (puntero NO encima) -->
                                                <VisualState x:Name="Selected">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ContentScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2" />
                                                        <DoubleAnimation Storyboard.TargetName="ContentScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                                        <DoubleAnimation Storyboard.TargetName="ContentTranslateTransform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </VisualState>

                                                <!-- Cuando está seleccionado Y el puntero está encima -->
                                                <VisualState x:Name="PointerOverSelected">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ContentScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2" />
                                                        <DoubleAnimation Storyboard.TargetName="ContentScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                                        <DoubleAnimation Storyboard.TargetName="ContentTranslateTransform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>

                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Cabecera de Título y Conmutadores -->
                <Grid Grid.Row="0" Padding="24,24,24,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Uid="AppTitle" FontSize="40" FontWeight="SemiBold"/>
                        <TextBlock x:Name="IconCountTextBlock" Margin="0,4,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Panel horizontal de herramientas del catálogo unificado con DropDownButtons -->
                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">

                        <!-- DropDownButton de Filtros Unificados (Categoría y Tamaño de Icono) -->
                        <DropDownButton x:Uid="Toolbar_Filters_Button" ToolTipService.ToolTip="Filtrar iconos">
                            <DropDownButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xE71C;" FontSize="16"/>
                                    <TextBlock x:Uid="Toolbar_Filters_Text" Text="Filtros" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DropDownButton.Content>
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Spacing="12" MinWidth="240" Padding="8">
                                        <TextBlock x:Uid="Toolbar_Filters_Title" Text="Filtros del catálogo" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="4,0,0,4"/>

                                        <StackPanel Spacing="4">
                                            <TextBlock x:Uid="Toolbar_Filters_CategoryLabel" Text="Categoría" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0,0,0"/>
                                            <ComboBox x:Name="CategoryComboBox"
                                                      HorizontalAlignment="Stretch"
                                                      SelectionChanged="CategoryComboBox_SelectionChanged"/>
                                        </StackPanel>

                                        <StackPanel Spacing="4">
                                            <TextBlock x:Uid="Toolbar_Filters_SizeLabel" Text="Tamaño" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0,0,0"/>
                                            <ComboBox x:Name="SizeComboBox"
                                                      HorizontalAlignment="Stretch"
                                                      SelectionChanged="SizeComboBox_SelectionChanged"/>
                                        </StackPanel>

                                        <Button x:Uid="Toolbar_Filters_ResetButton"
                                                Content="Restablecer filtros" 
                                                HorizontalAlignment="Stretch" 
                                                Margin="0,8,0,0"
                                                Click="ResetFilters_Click"
                                                Style="{StaticResource AccentButtonStyle}"/>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <!-- DropDownButton de Diseño (GridSizeSwitcher) -->
                        <DropDownButton x:Uid="Toolbar_Design_Button" ToolTipService.ToolTip="Cambiar diseño">
                            <DropDownButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xF115;" FontSize="16"/>
                                    <TextBlock x:Uid="Toolbar_Design_ButtonText" Text="Diseño" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DropDownButton.Content>
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Spacing="8" MinWidth="220" Padding="8">
                                        <TextBlock x:Uid="Toolbar_Design_Title" Text="Diseño de cuadrícula" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="4,0,0,4"/>
                                        <controls:GridSizeSwitcher x:Name="IconViewSwitcher" SelectionChanged="IconViewSwitcher_SelectionChanged" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <Button x:Name="ToggleSidePanelButton" Click="ToggleSidePanelButton_Click" Background="Transparent" BorderThickness="0" Width="40" Height="40" ToolTipService.ToolTip="Mostrar/Ocultar panel de detalles">
                            <FontIcon FontFamily="{StaticResource FluentIconsRegular}" Glyph="&#xE8BD;"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Selector de Estilo de Iconos (Todos, Regular, Filled, Light, Redimensionable, Favoritos) -->
                <SelectorBar x:Name="StyleSelectorBar"
                             Grid.Row="1"
                             SelectionChanged="StyleSelectorBar_SelectionChanged"
                             Margin="24,0,24,12"
                             HorizontalAlignment="Left">
                    <SelectorBarItem x:Name="AllSelectorItem" x:Uid="SelectorBar_All" Text="Todos" IsSelected="True" Tag="All"/>
                    <SelectorBarItem x:Name="RegularSelectorItem" x:Uid="SelectorBar_Regular" Text="Regular" Tag="Regular"/>
                    <SelectorBarItem x:Name="FilledSelectorItem" x:Uid="SelectorBar_Filled" Text="Filled" Tag="Filled"/>
                    <SelectorBarItem x:Name="LightSelectorItem" x:Uid="SelectorBar_Light" Text="Light" Tag="Light"/>
                    <SelectorBarItem x:Name="ResizableSelectorItem" x:Uid="SelectorBar_Resizable" Text="Resizable" Tag="Resizable"/>
                    <SelectorBarItem x:Name="FavoritesSelectorItem" x:Uid="SelectorBar_Favorites" Text="Favoritos" Tag="Favorites"/>
                </SelectorBar>

                <!-- Cuadrícula Principal de Iconos usando la plantilla predeterminada (MediumIconTemplate) -->
                <GridView x:Name="IconGridView" 
                          Grid.Row="2" 
                          ItemsSource="{x:Bind FilteredIcons}" 
                          Padding="24,12,24,24" 
                          HorizontalAlignment="Center"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemContainerStyle="{StaticResource RoundedGridViewItemStyle}"
                          SelectionChanged="IconGridView_SelectionChanged">
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True"/>
                        </TransitionCollection>
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemTemplate>
                        <StaticResource ResourceKey="MediumIconTemplate"/>
                    </GridView.ItemTemplate>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>

                <!-- Mensaje flotante de "Sin resultados" administrado desde el filtrado en C# -->
                <StackPanel x:Name="NoResultsStackPanel"
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Visibility="Collapsed">
                    <FontIcon FontFamily="{StaticResource FluentIconsRegular}" 
                              Glyph="&#xF4A5;" 
                              FontSize="48" 
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="NoResultsTextBlock"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- NUEVO: Panel de "Aún no hay favoritos" para la pestaña de Favoritos vacía -->
                <StackPanel x:Name="NoFavoritesStackPanel"
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Visibility="Collapsed">
                    <FontIcon FontFamily="{StaticResource FluentIconsFilled}" 
                              Glyph="&#xF718;" 
                              FontSize="64" 
                              Foreground="{ThemeResource SystemAccentColor}"/>
                    <TextBlock x:Uid="NoFavorites_Title"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Uid="NoFavorites_Description"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="300"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- PANEL DERECHO: CONTENEDOR DEL PANEL LATERAL -->
            <Grid Grid.Column="1"
                  x:Name="SidePanelContainer"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  Margin="0,0,12,12"
                  CornerRadius="8">
                <controls:SidePanelControl x:Name="SidePanel"/>
            </Grid>
        </Grid>

        <!-- PANTALLA DE BIENVENIDA -->
        <Grid x:Name="SplashGrid"
              Grid.RowSpan="2"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <Image Source="/Assets/SplashScreen.scale-200.svg"
                       Width="96"
                       Height="96" />
                <TextBlock x:Uid="SplashScreenTitle"
                           HorizontalAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                <ProgressRing x:Name="SplashProgressRing"
                              IsActive="True"
                              Margin="0,24,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>